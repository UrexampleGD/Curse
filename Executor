        for _, player in pairs(Players:GetPlayers()) do
            local modifiedCode = string.gsub(code, '"[^"]*"', function(match)
                if string.find(match, LocalPlayer.Name) then
                    return string.gsub(match, LocalPlayer.Name, player.Name)
                end
                return match
            end)
            sendCode(modifiedCode)
        end
    elseif target == "me" then
        sendCode(code)
    else
        local player = getPlayerFromName(target)
        if player then
            local modifiedCode = string.gsub(code, '"[^"]*"', function(match)
                if string.find(match, LocalPlayer.Name) then
                    return string.gsub(match, LocalPlayer.Name, player.Name)
                end
                return match
            end)
            sendCode(modifiedCode)
        else
            sendCode(code)
        end
    end
end

