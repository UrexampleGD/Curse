local function createMovingOutline(target)
    local out = Instance.new("Frame")
    out.BackgroundTransparency = 0
    out.BorderSizePixel = 0
    out.ZIndex = math.max(0, (target.ZIndex or 1) - 1)
    out.Parent = screenGui
    local outCorner = Instance.new("UICorner")
    outCorner.CornerRadius = UDim.new(0, 14)
    outCorner.Parent = out
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0))
    }
    grad.Rotation = 0
    grad.Parent = out
    task.spawn(function()
        while out.Parent and target.Parent do
            for i = 0, 360, 2 do
                grad.Rotation = i
                task.wait(0.02)
            end
            task.wait(0.01)
        end
    end)
    RunService.RenderStepped:Connect(function()
        if not target.Parent then
            out:Destroy()
            return
        end
        local absPos = target.AbsolutePosition
        local absSize = target.AbsoluteSize
        out.Position = UDim2.new(0, absPos.X - 3, 0, absPos.Y - 3)
        out.Size = UDim2.new(0, absSize.X + 6, 0, absSize.Y + 6)
    end)
    return out
end

